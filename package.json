{
  "name": "growth-ops-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,css}\"",
    "dead-code": "knip --no-exit-code",
    "tipos:bd": "node scripts/generar-tipos-bd.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:metrics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test tests/metrics/*.test.mjs",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:metrics",
    "mcp:supabase": "npx -y @supabase/mcp-server-supabase@latest --read-only --project-ref rgcbveflosqgxrcqlqzv",
    "mcp:search": "npx -y duckduckgo-mcp-server",
    "mcp:context7": "npx -y @upstash/context7-mcp",
    "mcp:repomix": "npx -y repomix --mcp",
    "context:build": "npx -y repomix --config repomix.config.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^171.4.0",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "next": "^15.5.25",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.10.1",
    "resend": "^6.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "autoprefixer": "^10.0.1",
    "dotenv": "^18.0.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.25",
    "knip": "^6.35.1",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
