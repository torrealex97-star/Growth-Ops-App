# Supabase (proyecto propio)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Site URL usada en callbacks de auth (login por email / magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Bearer JWT del MCP remoto de sequra (https://simba.sequra.com/mcp). CADUCA — cuando el cron
# de /api/evergreen/cron/sequra-morosos empiece a fallar con 401, hay que generar uno nuevo
# desde la sesión MCP de sequra y pegarlo aquí y en Vercel (Production env vars).
SEQURA_MCP_TOKEN=your_sequra_mcp_bearer_token_here

# Sentry (error tracking). Sin DSN, el SDK queda inerte (no manda nada) — crea un proyecto
# Next.js en sentry.io y pega su DSN aquí y en Vercel (Production + Preview env vars).
NEXT_PUBLIC_SENTRY_DSN=
# Opcionales, solo para subir source maps legibles en el build de producción (Vercel):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
