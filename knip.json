{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "next": {
    "entry": ["next.config.js", "middleware.ts"]
  },
  "entry": ["scripts/**/*.{js,mjs,ts}", "tests/**/*.test.mjs"],
